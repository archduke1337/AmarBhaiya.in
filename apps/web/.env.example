# Appwrite
NEXT_PUBLIC_APPWRITE_ENDPOINT=
NEXT_PUBLIC_APPWRITE_PROJECT_ID=
NEXT_PUBLIC_APPWRITE_DATABASE_ID=
APPWRITE_API_KEY=

# Stream Chat
NEXT_PUBLIC_STREAM_API_KEY=
STREAM_SECRET=

# Razorpay
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# PhonePe (optional)
PHONEPE_MERCHANT_ID=
PHONEPE_SECRET=

# EmailJS (optional)
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=

# App URL
NEXT_PUBLIC_APP_URL=

# Upstash Redis (REQUIRED for production rate limiting on Vercel)
# Without these, rate limiting uses in-memory store which is ineffective on multi-instance deployments.
# Get keys from https://console.upstash.com/
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Session cookie domain override (optional, defaults to amarbhaiya.in)
SESSION_COOKIE_BASE_DOMAIN=
